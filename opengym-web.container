[Unit]
Description=openGym web UI — nginx serving the PWA and proxying /api
After=network-online.target opengym-api.service opengym-media.service
Wants=network-online.target
Requires=opengym-api.service opengym-media.service

[Container]
Image=registry.gitlab.com/duartesantos8/opengym/web:1.3
AutoUpdate=registry

# No UserNS/User/Group — see the note in opengym-api.container. nginx starts as
# root inside the container (mapped to the host opengym user) and drops its
# workers to the image's nginx user.

Network=opengym.network
ContainerName=opengym-web

# Environment variables
EnvironmentFile=%h/.config/containers/systemd/opengym.env
EnvironmentFile=%h/.config/containers/systemd/opengym.override.env

# Exercise images and GIFs, downloaded once by opengym-media.service.
# :z (shared label), not :Z — opengym-media.service writes these dirs from a
# second container, and :Z would relabel them exclusively for one of the two.
Volume=%h/media/img:/usr/share/nginx/html/img:z,ro
Volume=%h/media/gif:/usr/share/nginx/html/gif:z,ro

# Port mapping — localhost only; Caddy on this host terminates TLS for
# https://gym.example.com. Container side is NGINX_PORT from opengym.env (8080,
# not 80, so nothing inside needs to bind a privileged port).
PublishPort=127.0.0.1:8085:8080

# Health check — mirrors the image's own HEALTHCHECK (busybox wget, no curl).
HealthCmd=wget --spider -q http://127.0.0.1:8080/ || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
