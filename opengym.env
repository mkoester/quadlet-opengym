# Shared, non-secret openGym settings. Instance-specific values (the domain, your
# admin user id) live in opengym.override.env, which is loaded after this file
# and therefore wins. Full reference: the upstream .env.example.

# ── Wiring between the two containers ──────────────────────────────────────
# BACKEND is an IP ADDRESS, NOT the container name — deliberately, and this is a
# deviation from upstream's docs. It must match IP= in opengym-api.container.
#
# Why: the web image's nginx template hardcodes `resolver 127.0.0.11`, which is
# DOCKER's embedded DNS. Podman's aardvark-dns listens on the network gateway
# (10.89.0.1 here) instead, so nginx's resolver gets connection-refused and every
# /api/ request 502s. Nothing can override it — BACKEND and PORT are envsubst
# placeholders in that template, the resolver address is not.
#
# The symptom is badly misleading, so don't re-derive it: both containers report
# HEALTHY (the web healthcheck probes /, which is static and needs no resolver),
# DNS genuinely works (`podman exec opengym-web wget -qO- http://opengym-api:3000/api/health`
# succeeds — it uses /etc/resolv.conf, which nginx's `resolver` directive ignores,
# as it also ignores /etc/hosts), and Caddy returns a 502 that looks like ITS
# problem. Only nginx's own log names the cause: `resolver: 127.0.0.11:53 …
# Connection refused`.
#
# An IP literal makes nginx skip DNS altogether (measured on mkde 2026-09-07: the
# same request returned {"ok":true} immediately after the switch). Upstream uses a
# variable in proxy_pass so a recreated api container is re-resolved per request
# (their issue #16) — pinning the IP removes the need for that, since the address
# no longer changes.
#
# Preferred over bind-mounting a patched copy of their template: opengym-web.container
# carries AutoUpdate=registry, so a copied template would silently go stale against
# a newer image.
#
# PORT is used by BOTH containers — the API listens on it and the web container
# proxies to the same value, so they cannot drift.
BACKEND=10.89.0.10
PORT=3000

# Port nginx listens on INSIDE the web container. 8080 rather than the image
# default of 80, so nothing in the container needs a privileged port. The web
# image renders its nginx config from this at start-up, so it works on the
# prebuilt image with no rebuild. Must match the container side of PublishPort=.
NGINX_PORT=8080

# Name shown in the passkey prompt.
RP_NAME=openGym

# ── Access control ─────────────────────────────────────────────────────────
# Hardened end state. INVITE_ONLY=1 needs an invite code generated from the admin
# dashboard, so it CANNOT be in force for the very first profile — see the
# two-step bootstrap in README.md and the override template.
INVITE_ONLY=1
ALLOW_GUEST=0

# How long a sign-in lasts, in days.
SESSION_DAYS=90

# ── Activity log ───────────────────────────────────────────────────────────
# On by default; IP addresses deliberately off (off | net | full).
AUDIT_LOG=1
AUDIT_MAX=5000
AUDIT_DAYS=90
AUDIT_IP=off

# Caddy sits in front, not Cloudflare, so leave CF-Connecting-IP dropped —
# setting it would let a direct caller forge the address the audit log records.
CF_CONNECTING_IP=

# ── AI Coach ───────────────────────────────────────────────────────────────
# Kill switch that outranks the in-app admin toggle. The default image carries no
# AI runtime at all, so this is belt-and-braces; drop it in the override if you
# ever want to connect a provider.
COACH_DISABLED=1
